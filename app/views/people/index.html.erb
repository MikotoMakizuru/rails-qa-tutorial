<h1 class="display-4 text-primary">People#index</h1>
<p><%= @msg %></p>
<table class="table">
  <tr>
    <th>ID</th><th>Name</th>
  </tr>
  <% @data.each do |person| %>
    <tr>
      <td><%= person.id %></td>
      <td><a href="/people/<%= person.id %>">
        <%= person.name %></a><td>
      </td>
    </tr>
  <% end %>
</table>
